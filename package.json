    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.3.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
